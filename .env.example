# ─── Techsara Secret Santa – environment ─────────────────────────────
# Copy to .env and adjust. `npm start` loads it automatically.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Dates you enter in the admin panel are interpreted in this time zone
TZ=Asia/Kolkata

# ─── Production (EC2 behind nginx with HTTPS) ────────────────────────
# NODE_ENV=production
# HOST=127.0.0.1
# TRUST_PROXY=1
# COOKIE_SECURE=true

# Folder for the SQLite database, uploads and (if DATA_KEY is unset) the key file.
# Back this folder up!
# DATA_DIR=/var/lib/techsara-santa

# 32-byte key that encrypts wish lists and assignments at rest.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is generated at DATA_DIR/secret.key. Losing it = wishes/assignments unreadable.
# DATA_KEY=

# First super admin – only used when the database has no admins yet.
# If ADMIN_PASSWORD is empty, a random one is printed in the console on first start.
ADMIN_EMAIL=admin@techsarasolutions.com
ADMIN_NAME=HR Admin
# ADMIN_PASSWORD=
